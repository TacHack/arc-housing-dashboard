# Local Postgres. Copy this file to .env and change it if your credentials differ.
# Never commit .env. Production credentials live in Vercel, not in git.
DATABASE_URL="postgresql://sober:sober@localhost:5432/sober_living_crm?schema=public"

# --- Production (Vercel + Neon) ---
# The Neon integration sets these on the Vercel project. Do not commit real values.
# DATABASE_URL is pooled (hostname contains -pooler) and is what the running app uses.
# DATABASE_URL_UNPOOLED is the direct URL. prisma migrate deploy and db seed use it.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional alias if you copied the direct URL from the Neon console by hand.
# DIRECT_URL=

# Sample data (Oak Street, River Bend, Jane Doe, two work orders) loads automatically
# on Vercel Production. Set to 0 to skip that. Set to 1 to also seed Preview builds.
# SEED_SAMPLE_DATA=1
