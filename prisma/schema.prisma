// Sober Living CRM — Sprint 1 + Work Orders + Night Check
// Kipu-like multi-tenant sober living operations

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  house_manager
  staff
  read_only
}

enum BedStatus {
  open
  occupied
  reserved
  offline
}

enum ResidentStatus {
  active
  alumni
  waitlist
}

enum WorkOrderCategory {
  maintenance
  cleaning
  safety
  supplies
  other
}

enum WorkOrderPriority {
  low
  normal
  high
  urgent
}

enum WorkOrderStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  houses        House[]
  residents     Resident[]
  workOrders    WorkOrder[]
  auditLogs     AuditLog[]
  residentMeds  ResidentMed[]
  shiftSessions ShiftSession[]
  nightChecks   NightCheck[]
  clientLogs           ClientLog[]
  uaResults            UaResult[]
  behavioralContracts  BehavioralContract[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  email          String
  name           String
  role           UserRole @default(staff)
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assignedWorkOrders WorkOrder[]        @relation("WorkOrderAssignee")
  createdWorkOrders  WorkOrder[]        @relation("WorkOrderCreator")
  workOrderEvents    WorkOrderEvent[]
  auditLogs          AuditLog[]

  @@unique([orgId, email])
  @@index([orgId])
}

model House {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  beds          Bed[]
  residents     Resident[]
  workOrders    WorkOrder[]
  shiftSessions ShiftSession[]
  nightChecks   NightCheck[]
  uaResults     UaResult[]

  @@index([orgId])
}

model Bed {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @db.Uuid
  houseId   String    @db.Uuid
  label     String
  status    BedStatus @default(open)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  house     House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  residents Resident[]

  @@unique([houseId, label])
  @@index([orgId])
  @@index([houseId])
  @@index([status])
}

model Resident {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @db.Uuid
  houseId    String?        @db.Uuid
  bedId      String?        @db.Uuid
  firstName  String
  lastName   String
  dob                   DateTime?
  insuranceCarrier      String?
  insuranceMemberId     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  admissionDate         DateTime?
  status     ResidentStatus @default(waitlist)
  moveInAt   DateTime?
  moveOutAt  DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  house            House?       @relation(fields: [houseId], references: [id], onDelete: SetNull)
  bed              Bed?         @relation(fields: [bedId], references: [id], onDelete: SetNull)
  meds             ResidentMed[]
  nightCheckEntries NightCheckEntry[]
  clientLogs          ClientLog[]
  uaResults           UaResult[]
  behavioralContracts BehavioralContract[]

  @@index([orgId])
  @@index([houseId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model WorkOrder {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @db.Uuid
  houseId      String            @db.Uuid
  number       Int               @default(autoincrement())
  room         String?
  assigneeName String?
  title        String
  description  String?
  category     WorkOrderCategory @default(other)
  priority     WorkOrderPriority @default(normal)
  status       WorkOrderStatus   @default(open)
  createdById  String?           @db.Uuid
  assigneeId   String?           @db.Uuid
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  house        House                @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee     User?                @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events       WorkOrderEvent[]
  attachments  WorkOrderAttachment[]

  @@index([orgId])
  @@index([houseId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
}

model WorkOrderEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  userId      String?  @db.Uuid
  type        String
  message     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([workOrderId])
  @@index([createdAt])
}

model WorkOrderAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  fileName    String
  mimeType    String?
  url         String
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workOrderId])
}

model ResidentMed {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  residentId  String   @db.Uuid
  description String
  dosage      String?
  amount      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([residentId])
}

enum ShiftSessionStatus {
  open
  closed
}

enum NightCheckStatus {
  in_progress
  completed
}

enum NightCheckEntryStatus {
  pending
  present
  out_on_pass
  late
  missing
  skipped
}

model ShiftSession {
  id        String             @id @default(uuid()) @db.Uuid
  orgId     String             @db.Uuid
  houseId   String             @db.Uuid
  status    ShiftSessionStatus @default(open)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  house        House        @relation(fields: [houseId], references: [id], onDelete: Cascade)
  nightChecks  NightCheck[]
  uaResults    UaResult[]

  @@index([orgId])
  @@index([houseId])
  @@index([status])
}

model NightCheck {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @db.Uuid
  houseId        String           @db.Uuid
  shiftSessionId String           @db.Uuid
  status         NightCheckStatus @default(in_progress)
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  handoffNote    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  house        House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  shiftSession ShiftSession      @relation(fields: [shiftSessionId], references: [id], onDelete: Cascade)
  entries      NightCheckEntry[]

  @@index([orgId])
  @@index([houseId])
  @@index([shiftSessionId])
  @@index([status])
}

model NightCheckEntry {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @db.Uuid
  nightCheckId String                @db.Uuid
  residentId   String                @db.Uuid
  status       NightCheckEntryStatus @default(pending)
  note         String?
  markedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  nightCheck NightCheck @relation(fields: [nightCheckId], references: [id], onDelete: Cascade)
  resident   Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([nightCheckId, residentId])
  @@index([orgId])
  @@index([nightCheckId])
  @@index([residentId])
}

enum ClientLogType {
  progress
  behavior
  shift
}

model ClientLog {
  id         String        @id @default(uuid()) @db.Uuid
  orgId      String        @db.Uuid
  residentId String        @db.Uuid
  type       ClientLogType
  body       String
  author     String?
  createdAt  DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([residentId])
  @@index([createdAt])
  @@index([type])
}

enum UaOutcome {
  neg
  pos
  refused
  unable
}

model UaResult {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  residentId     String    @db.Uuid
  houseId        String?   @db.Uuid
  shiftSessionId String?   @db.Uuid
  outcome        UaOutcome
  note           String?
  author         String?
  testedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  house        House?        @relation(fields: [houseId], references: [id], onDelete: SetNull)
  shiftSession ShiftSession? @relation(fields: [shiftSessionId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([residentId])
  @@index([houseId])
  @@index([shiftSessionId])
  @@index([testedAt])
  @@index([outcome])
}

enum BehavioralContractStatus {
  active
  completed
  void
}

model BehavioralContract {
  id         String                   @id @default(uuid()) @db.Uuid
  orgId      String                   @db.Uuid
  residentId String                   @db.Uuid
  title      String
  notes      String?
  signedAt   DateTime?
  status     BehavioralContractStatus @default(active)
  fileName   String?
  mimeType   String?
  filePath   String?
  fileUrl    String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([residentId])
  @@index([status])
  @@index([createdAt])
}
